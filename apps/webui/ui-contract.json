{
  "_about": "What the web UI needs from core. `capabilities` are the registry operations its pages call; `fields` are the output fields its render code reads (a dotted path, [] for each item of a list). src/oaken/core/operations/tests/test_ui_contract.py checks every one against the real operation schemas, so a renamed or dropped field fails a test instead of a page.",
  "capabilities": [
    "list_messages", "search", "get_message", "get_thread", "get_raw", "message_presented",
    "mark_read", "mark_unread", "list_mailbox", "create_folder", "create_label",
    "move_to_folder", "set_labels", "sync_now",
    "list_accounts", "get_account", "create_account", "set_account_config", "set_account_password",
    "check_account", "remove_account", "start_authorization", "authorization_status",
    "list_operations",
    "sieve_list", "sieve_get", "sieve_check", "sieve_test", "sieve_save", "sieve_delete",
    "reprocess"
  ],
  "fields": {
    "list_messages": [
      "items[].message_id", "items[].subject", "items[].from_name", "items[].from_addr",
      "items[].date", "items[].snippet", "items[].labels", "items[].is_read",
      "items[].starred", "items[].has_attachments", "total", "offset", "truncated"
    ],
    "search": [
      "items[].message_id", "items[].subject", "items[].from_name", "items[].from_addr",
      "items[].date", "items[].snippet", "items[].labels", "items[].is_read",
      "items[].starred", "items[].has_attachments", "total", "total_exact", "offset",
      "degraded"
    ],
    "get_message": [
      "message_id", "thread_key", "subject", "from_name", "from_addr", "to_addrs", "cc_addrs", "date",
      "labels", "location", "is_read", "starred", "text", "attachments",
      "message_id_header", "references"
    ],
    "get_thread": [
      "items[].message_id", "items[].parent_id", "items[].depth", "items[].subject",
      "items[].from_name", "items[].from_addr", "items[].date", "items[].snippet",
      "items[].is_read", "total", "truncated"
    ],
    "list_mailbox": ["inbox", "discarded", "folders", "labels"],
    "list_accounts": [
      "accounts[].account_id", "accounts[].provider", "accounts[].display_name",
      "accounts[].receive_only", "accounts[].capabilities"
    ],
    "get_account": [
      "account_id", "provider", "display_name", "config", "receive_only", "capabilities", "problem"
    ],
    "set_account_config": [
      "account.account_id", "account.display_name", "account.config", "account.receive_only",
      "account.capabilities", "restart_needed"
    ],
    "check_account": ["ok", "detail"],
    "start_authorization": ["url"],
    "authorization_status": ["state", "detail"],
    "remove_account": ["removed", "schedules_removed", "restart_needed", "mail_kept"],
    "list_operations": ["operations[].name"],
    "sieve_list": [
      "enabled", "directory", "sha256", "scripts[].name", "scripts[].sha256",
      "problems[].name", "problems[].problem"
    ],
    "sieve_get": ["name", "text", "sha256"],
    "sieve_check": ["ok", "error", "line", "requires", "sha256"],
    "sieve_test": [
      "check.ok", "check.error", "check.line", "disposition", "rule",
      "effects[].kind", "effects[].value", "effects[].rule", "errors"
    ],
    "sieve_save": ["saved", "check.ok", "check.error", "check.line", "sha256"],
    "sieve_delete": ["deleted"],
    "mark_read": ["changed", "unchanged"],
    "mark_unread": ["changed", "unchanged"],
    "create_folder": ["path", "created"],
    "create_label": ["name", "created"],
    "move_to_folder": ["path", "moved"],
    "set_labels": ["changed"]
  }
}
